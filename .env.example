APP_NAME="Work Atlas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=work_atlas
DB_USERNAME=work_atlas
# Local development only (matches compose.yaml). Never reuse it anywhere else.
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Horizon needs the Redis queue.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI gateway (PLAN M9). The cap per batch in USD; 0 refuses every paid call until the maintainer sets it (O3).
AI_MAX_BATCH_USD=0
AI_EXPAND_PROVIDER=fake
AI_EXPAND_MODEL=fake-model
AI_WAVE1_A_PROVIDER=fake
AI_WAVE1_A_MODEL=fake-model-a
AI_WAVE1_B_PROVIDER=fake
AI_WAVE1_B_MODEL=fake-model-b

# Index gate (PLAN M14, A11a). Off for the Phase 1 beta: every page noindex, empty sitemap.
ATLAS_INDEX_GATE=false
