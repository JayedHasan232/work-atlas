#!/usr/bin/env bash
# Developer Certificate of Origin check.
#
# Every non-merge commit in <base>..<head> must carry a "Signed-off-by: Name <email>" trailer whose
# email matches the commit author's email (case-insensitive). Merge commits are skipped.
#
# Usage: scripts/ci/check-dco <base> <head>
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "usage: $0 <base> <head>" >&2
  exit 2
fi

base=$1
head=$2
checked=0
missing=0

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Read the list first: a git error inside "< <(...)" would not stop the script, and the check would
# pass with "All 0 commit(s)" on an unknown revision.
commits=$(git rev-list --no-merges "${base}..${head}")

while IFS= read -r sha; do
  [ -n "$sha" ] || continue
  checked=$((checked + 1))

  author_email=$(lower "$(git show -s --format='%ae' "$sha")")
  subject=$(git show -s --format='%s' "$sha")
  trailers=$(git show -s --format='%(trailers:key=Signed-off-by,valueonly)' "$sha")

  signed=false
  while IFS= read -r line; do
    line=$(lower "${line%$'\r'}")
    case "$line" in
      ?*" <${author_email}>") signed=true ;;
    esac
  done <<< "$trailers"

  if [ "$signed" = true ]; then
    echo "ok       ${sha:0:12} ${subject}"
  else
    echo "MISSING  ${sha:0:12} ${subject}"
    missing=$((missing + 1))
  fi
done <<< "$commits"

if [ "$missing" -gt 0 ]; then
  cat >&2 <<EOF

${missing} of ${checked} commit(s) lack a sign-off matching the author's email.
Sign off with "git commit -s". To fix the commits on your branch:
  git rebase --signoff <base branch>
  git push --force-with-lease
See CONTRIBUTING.md (Developer Certificate of Origin).
EOF
  exit 1
fi

echo "All ${checked} commit(s) are signed off."
