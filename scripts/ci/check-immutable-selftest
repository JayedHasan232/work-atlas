#!/usr/bin/env bash
# Self-test for scripts/ci/check-immutable. Builds throwaway repositories and checks that the script
# passes new prompt and schema files and fails edits, deletions and renames of committed ones.
#
# Usage: scripts/ci/check-immutable-selftest
set -euo pipefail

check="$(cd "$(dirname "$0")" && pwd)/check-immutable"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Ignore the caller's git config (signing keys, hooks, templates).
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME="Test Author" GIT_AUTHOR_EMAIL="author@example.com"
export GIT_COMMITTER_NAME="Test Author" GIT_COMMITTER_EMAIL="author@example.com"

failures=0

new_repo() {
  rm -rf "$work/repo"
  git init -q -b main "$work/repo"
  cd "$work/repo"
  mkdir -p data/prompts/wave1 data/schemas/wave1 docs
  echo "prompt v1" > data/prompts/wave1/fields.v1.md
  echo '{"type": "object"}' > data/schemas/wave1/fields.v1.json
  echo "notes" > docs/notes.md
  git add -A
  git commit -q -m "base"
  base=$(git rev-parse HEAD)
  git switch -q -c topic
}

commit_all() { git add -A && git commit -q -m "$1"; }

expect() {
  local want=$1 name=$2 got=0
  "$check" "$base" HEAD > "$work/out" 2>&1 || got=$?
  if { [ "$want" = pass ] && [ "$got" -eq 0 ]; } || { [ "$want" = fail ] && [ "$got" -eq 1 ]; }; then
    echo "ok    ${name}"
  else
    echo "FAIL  ${name} (wanted ${want}, exit ${got})"
    sed 's/^/      /' "$work/out"
    failures=$((failures + 1))
  fi
}

new_repo
echo "prompt v2" > data/prompts/wave1/fields.v2.md
echo '{"type": "object", "required": []}' > data/schemas/wave1/fields.v2.json
commit_all "new versions"
expect pass "new prompt and schema versions pass"

new_repo
echo "more notes" >> docs/notes.md
commit_all "docs"
expect pass "changes outside data/prompts and data/schemas pass"

new_repo
echo "edited" >> data/prompts/wave1/fields.v1.md
commit_all "edit prompt"
expect fail "an edited prompt fails"

new_repo
echo '{"type": "array"}' > data/schemas/wave1/fields.v1.json
commit_all "edit schema"
expect fail "an edited schema fails"

new_repo
git rm -q data/prompts/wave1/fields.v1.md
git commit -q -m "delete prompt"
expect fail "a deleted prompt fails"

new_repo
git mv data/schemas/wave1/fields.v1.json data/schemas/wave1/renamed.v1.json
git commit -q -m "rename schema"
expect fail "a renamed schema fails"

new_repo
echo "edited" >> data/prompts/wave1/fields.v1.md
commit_all "edit"
git checkout -q "$base" -- data/prompts/wave1/fields.v1.md
commit_all "restore"
expect pass "an edit that was undone on the branch passes"

new_repo
git switch -q main
echo "edited on main" >> data/prompts/wave1/fields.v1.md
commit_all "edit on the base branch"
base=$(git rev-parse HEAD)
git switch -q topic
echo "prompt v2" > data/prompts/wave1/fields.v2.md
commit_all "new version on topic"
expect pass "a change that is only on the base branch does not count"

new_repo
expect pass "an empty range passes"

if [ "$failures" -gt 0 ]; then
  echo "${failures} self-test case(s) failed." >&2
  exit 1
fi
echo "All check-immutable self-tests passed."
